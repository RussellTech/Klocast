---
import { canonicalUrl, FEED_PATH, SITE_DESCRIPTION, SITE_ORIGIN, SITE_TITLE } from '../lib/site';
interface Props {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  jsonLd?: Record<string, unknown>;
}
const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  path = '/',
  image = '/images/podcast-artwork.jpg',
  jsonLd,
} = Astro.props;
const canonical = canonicalUrl(path);
const imageUrl = image.startsWith('http') ? image : `${SITE_ORIGIN}${image}`;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Klocast podcast RSS feed" href={canonicalUrl(FEED_PATH)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/">Klocast <span>Talking about SEO and the Web</span></a><nav aria-label="Primary">
          <a href="/">Episodes</a><a href={FEED_PATH}>RSS feed</a>
        </nav>
      </div>
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>Klocast – Talking about SEO and the Web</p><a href={FEED_PATH}>Subscribe via RSS</a>
      </div>
    </footer>
  </body>
</html>
<style is:global>
  :root {
    font-family:
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
    color: #0b0b0b;
    background: #fff;
    --ink: #0b0b0b;
    --muted: #5d5d5d;
    --line: #d8d8d8;
  }
  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    line-height: 1.6;
  }
  a {
    color: inherit;
    text-underline-offset: 0.18em;
  }
  a:focus-visible,
  button:focus-visible,
  audio:focus-visible {
    outline: 3px solid #e8c547;
    outline-offset: 4px;
  }
  .shell {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
  }
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -5rem;
    background: #fff;
    color: #000;
    padding: 0.7rem 1rem;
    z-index: 10;
  }
  .skip-link:focus {
    top: 1rem;
  }
  .site-header {
    background: #000;
    color: #fff;
  }
  .header-inner,
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.2rem 0;
  }
  .brand {
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .brand span {
    display: block;
    font-size: 0.78rem;
    font-weight: 400;
    opacity: 0.72;
  }
  nav {
    display: flex;
    gap: 1.1rem;
    font-size: 0.94rem;
  }
  nav a {
    color: #fff;
  }
  main {
    min-height: 70vh;
  }
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .footer-inner {
    padding: 2rem 0;
  }
  @media (max-width: 600px) {
    .header-inner,
    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
    }
    nav {
      gap: 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    * {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
